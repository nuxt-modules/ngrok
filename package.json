{
  "name": "@nuxtjs/ngrok",
  "version": "3.0.1",
  "description": "Exposes your localhost to the world for easy testing and sharing! No need to mess with DNS or deploy just to have others test out your changes!",
  "repository": "nuxt-modules/ngrok",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:preview": "nuxi preview playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run build && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@nuxt/kit": "^4.4.2",
    "consola": "^3.4.2",
    "defu": "^6.1.4"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.3",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@types/node": "^25.5.0",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.4",
    "nuxt": "^4.4.2",
    "typescript": "latest",
    "vue-tsc": "^3.2.5"
  }
}
